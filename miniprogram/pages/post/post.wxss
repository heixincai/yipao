.divider {
  height: 1rpx;
  background: #eef0f3;
  margin: 24rpx 0;
}

.participant {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.me-tag {
  color: #0b8f56;
  font-size: 22rpx;
  background: #e8f7ef;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.action-btn {
  margin-bottom: 24rpx;
}

.action-row {
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-half {
  flex: 1;
}

.attendee {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.checked {
  color: #0b8f56;
}

.unchecked {
  color: #d92d20;
}

.comment {
  margin-top: 24rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  font-size: 24rpx;
}

.comment-editor {
  align-items: flex-end;
  margin-top: 24rpx;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  min-height: 80rpx;
}

.send-btn {
  padding: 0 32rpx;
  line-height: 2.8;
}
