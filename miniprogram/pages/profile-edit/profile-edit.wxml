<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-preview" src="{{avatarUrl}}" />
        <text wx:else>选择头像</text>
      </button>
    </view>

    <view class="field">
      <text class="field-label">昵称</text>
      <input class="input" type="nickname" placeholder="跑者昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
    </view>

    <view class="field">
      <text class="field-label">常跑点（最多 5 个）</text>
      <view class="spot-grid">
        <view
          wx:for="{{spots}}"
          wx:key="_id"
          class="spot-chip {{item.selected ? 'spot-active' : ''}}"
          data-id="{{item._id}}"
          bindtap="toggleSpot"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">你平时的强度</text>
      <picker range="{{paceLevels}}" bindchange="onPaceChange">
        <view class="input">{{paceLevels[paceIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">一句话介绍</text>
      <textarea class="textarea" placeholder="例如：下班后喜欢在西湖边慢跑 5 公里" value="{{intro}}" bindinput="onIntroInput" maxlength="100" />
    </view>

    <view class="btn-primary {{saving ? 'btn-disabled' : ''}}" bindtap="save">保存</view>
  </view>
</view>
